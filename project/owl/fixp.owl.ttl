	rdfs:label "FixpNegotiationReject" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n124 , _:c14n187 , _:c14n217 , _:c14n240 , _:c14n271 , _:c14n278 , _:c14n29 , _:c14n290 , _:c14n37 , _:c14n72 , _:c14n82 , _:c14n83 ;
	skos:definition "A server's refusal to create a session. The server sends nothing more and closes the transport." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "server" ;
	fixp:sbe_name "NegotiationReject" ;
	fixp:sbe_template_id "3" .
fixp:FixpNegotiationRejectCode\#Credentials a owl:Class ;
	rdfs:label "Credentials" ;
	rdfs:subClassOf fixp:FixpNegotiationRejectCode ;
	skos:definition "The server could not identify the client, or would not let it in." ;
	fixp:sbe_value "0" .
fixp:FixpNegotiationRejectCode\#DuplicateId a owl:Class ;
	rdfs:label "DuplicateId" ;
	rdfs:subClassOf fixp:FixpNegotiationRejectCode ;
	skos:definition "The client chose a session identifier that is not new." ;
	fixp:sbe_value "2" .
fixp:FixpNegotiationRejectCode\#FlowTypeNotSupported a owl:Class ;
	rdfs:label "FlowTypeNotSupported" ;
	rdfs:subClassOf fixp:FixpNegotiationRejectCode ;
	skos:definition "The server does not offer the flow type the client asked to send." ;
	fixp:sbe_value "1" .
fixp:FixpNegotiationRejectCode\#Unspecified a owl:Class ;
	rdfs:label "Unspecified" ;
	rdfs:subClassOf fixp:FixpNegotiationRejectCode ;
	skos:definition "Some reason the other values do not name." ;
	fixp:sbe_value "3" .
fixp:FixpNegotiationRejectCode a owl:Class ;
	rdfs:label "FixpNegotiationRejectCode" ;
	owl:unionOf _:c14n205 ;
	skos:definition "Why a server refused to create a session." ;
	skos:inScheme fixp:schema\/fixp_core ;
	linkml:permissible_values fixp:FixpNegotiationRejectCode\#Credentials , fixp:FixpNegotiationRejectCode\#DuplicateId , fixp:FixpNegotiationRejectCode\#FlowTypeNotSupported , fixp:FixpNegotiationRejectCode\#Unspecified ;
	fixp:sbe_encoding_type "uint8" ;
	fixp:sbe_name "NegotiationRejectCode" .
fixp:FixpNegotiationResponse a owl:Class ;
	rdfs:label "FixpNegotiationResponse" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n161 , _:c14n163 , _:c14n18 , _:c14n219 , _:c14n251 , _:c14n255 , _:c14n287 , _:c14n306 , _:c14n39 , _:c14n55 , _:c14n56 , _:c14n58 ;
	skos:definition "A server's acceptance of a new session, stating the flow type it will send back." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "server" ;
	fixp:sbe_name "NegotiationResponse" ;
	fixp:sbe_template_id "2" .
fixp:FixpNotApplied a owl:Class ;
	rdfs:label "FixpNotApplied" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n20 , _:c14n218 , _:c14n303 , _:c14n325 , _:c14n333 , _:c14n66 ;
	skos:definition "An application message telling the party that sends an idempotent flow about a gap: a run of operations that did not take effect. That party's application decides what to do." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	skos:note "Like any application message, it uses up one number in the sequence of the flow it travels on." ;
	fixp:fixp_flow_of "peer" ;
	fixp:fixp_flow_types "Idempotent" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "NotApplied" ;
	fixp:sbe_template_id "18" .
fixp:FixpParty\#client a owl:Class ;
	rdfs:label "client" ;
	rdfs:subClassOf fixp:FixpParty ;
	skos:definition "The party that opens a session with a server." .
fixp:FixpParty\#publisher a owl:Class ;
	rdfs:label "publisher" ;
	rdfs:subClassOf fixp:FixpParty ;
	skos:definition "The only party that sends in a multicast." .
fixp:FixpParty\#server a owl:Class ;
	rdfs:label "server" ;
	rdfs:subClassOf fixp:FixpParty ;
	skos:definition "The party that accepts the client's session." .
fixp:FixpParty a owl:Class ;
	rdfs:label "FixpParty" ;
	owl:unionOf _:c14n235 ;
	skos:definition "The side that sends a step." ;
	skos:inScheme fixp:schema\/fixp_exchange ;
	linkml:permissible_values fixp:FixpParty\#client , fixp:FixpParty\#publisher , fixp:FixpParty\#server .
fixp:FixpRetransmission a owl:Class ;
	rdfs:label "FixpRetransmission" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n112 , _:c14n139 , _:c14n149 , _:c14n15 , _:c14n171 , _:c14n23 , _:c14n26 , _:c14n263 , _:c14n275 , _:c14n291 , _:c14n297 , _:c14n99 ;
	skos:definition "Introduces a batch of resent messages, which are numbered by counting from the number it gives. A request may be answered in several batches." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_of "own" ;
	fixp:fixp_flow_types "Recoverable" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "any" ;
