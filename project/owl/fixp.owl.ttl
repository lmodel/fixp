    skos:definition "Abstract base class for every FIXP session message." ;
    skos:exactMatch fixp:FixpSessionMessage ;
    skos:inScheme <https://w3id.org/lmodel/fixp> .

fixp:FIXInt a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:session_id a owl:DatatypeProperty ;
    rdfs:label "session_id" ;
    rdfs:range fixp:FIXString ;
    skos:closeMatch gist_linkml:idText ;
    skos:definition "FIX field 'SessionId' (tag 1)." ;
    skos:exactMatch fixr:SessionId ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    skos:relatedMatch common_domain_model:eventIdentifier,
        common_domain_model:messageId,
        fluxnova_bpm_platform:id,
        gist_linkml:isIdentifiedBy ;
    fixp:fix_field_name "SessionId" ;
    fixp:fix_tag "1" .


