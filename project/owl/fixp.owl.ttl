xsd:base64Binary a rdfs:Datatype ;
	owl:equivalentClass _:c14n228 .
<https://w3id.org/lmodel/fixp.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/FIXTradingCommunity/fixp-specification/tree/v1.0-STANDARD/v1-0-STANDARD> ;
	dcterms:title "FIX Performance Session Layer (FIXP)" ;
	pav:version "1.0" ;
	schema1:keywords "FIX" , "FIXP" , "session layer" , "trading" ;
	a owl:Ontology ;
	rdfs:label "fixp" ;
	rdfs:seeAlso <https://github.com/FIXTradingCommunity/fixp-specification> , <https://lmodel.github.io/fixp> ;
	skos:definition "A LinkML model of the FIX Performance Session Layer 1.0, the FIX Trading Community's session protocol for fast trading links. It describes FIXP's session messages, their fields and value lists, exchanges of those messages on one session, and the rules of engagement two parties agree on. A message is described by its fields, so the model works with any encoding." ;
	skos:note "An exchange starts at FixpExchange, the tree root. A single message validates against its own class, such as FixpNegotiate, and a rules-of-engagement record against FixpRulesOfEngagement. upstream/ holds the specification's resource files unchanged, tests/test_coverage.py compares the modules with them, and scripts/check_upstream_release.py reports when they change." ;
	fixp:upstream_commit "6d89f5fa66d544ea6b41e93853c23292505e49c6" ;
	fixp:upstream_tag "v1.0-STANDARD" .
fixp:FixpApplied a owl:Class ;
	rdfs:label "FixpApplied" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n117 , _:c14n181 , _:c14n195 , _:c14n216 , _:c14n294 , _:c14n4 ;
	skos:definition "An optional application message telling the party that sends an idempotent flow which of its operations took effect, where no business message already says so." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	skos:note "Like any application message, it uses up one number in the sequence of the flow it travels on." ;
	fixp:fixp_flow_of "peer" ;
	fixp:fixp_flow_types "Idempotent" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "Applied" ;
	fixp:sbe_template_id "17" .
fixp:FixpContext a owl:Class ;
	rdfs:label "FixpContext" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n111 , _:c14n162 , _:c14n225 , _:c14n250 , _:c14n268 , _:c14n323 ;
	skos:definition "On a transport that several sessions share, names the session the following messages belong to and, when the flow is sequenced, where its numbering continues." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_of "own" ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "true" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "Context" ;
	fixp:sbe_template_id "9" .
fixp:FixpDeltaMillisecs a rdfs:Datatype ;
	owl:equivalentClass _:c14n204 .
fixp:FixpEstablish a owl:Class ;
	rdfs:label "FixpEstablish" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n169 , _:c14n182 , _:c14n19 , _:c14n215 , _:c14n234 , _:c14n262 , _:c14n273 , _:c14n296 , _:c14n3 , _:c14n315 , _:c14n327 , _:c14n33 , _:c14n34 , _:c14n62 , _:c14n69 ;
	skos:definition "A client's request to tie a negotiated session to the very transport this message arrives on. After a disconnection it is sent again to re-bind." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "client" ;
	fixp:sbe_name "Establish" ;
	fixp:sbe_template_id "5" .
fixp:FixpEstablishmentAck a owl:Class ;
	rdfs:label "FixpEstablishmentAck" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n1 , _:c14n10 , _:c14n115 , _:c14n2 , _:c14n264 , _:c14n300 , _:c14n301 , _:c14n305 , _:c14n32 , _:c14n321 , _:c14n47 , _:c14n90 ;
	skos:definition "A server's acceptance of the binding. From here, application messages may flow." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "server" ;
	fixp:sbe_name "EstablishmentAck" ;
	fixp:sbe_template_id "6" .
fixp:FixpEstablishmentReject a owl:Class ;
	rdfs:label "FixpEstablishmentReject" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n113 , _:c14n13 , _:c14n142 , _:c14n158 , _:c14n192 , _:c14n229 , _:c14n241 , _:c14n41 , _:c14n5 , _:c14n78 , _:c14n95 , _:c14n96 ;
	skos:definition "A server's refusal of the binding." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "server" ;
	fixp:sbe_name "EstablishmentReject" ;
	fixp:sbe_template_id "7" .
fixp:FixpEstablishmentRejectCode\#AlreadyEstablished a owl:Class ;
	rdfs:label "AlreadyEstablished" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "The server had already acknowledged a binding, so this request repeats it." ;
	fixp:sbe_value "1" .
fixp:FixpEstablishmentRejectCode\#Credentials a owl:Class ;
	rdfs:label "Credentials" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "The server could not identify the client, or would not let it in." ;
	fixp:sbe_value "4" .
fixp:FixpEstablishmentRejectCode\#KeepaliveInterval a owl:Class ;
	rdfs:label "KeepaliveInterval" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "The client's keep-alive interval is outside what the server accepts." ;
	fixp:sbe_value "3" .
fixp:FixpEstablishmentRejectCode\#SessionBlocked a owl:Class ;
	rdfs:label "SessionBlocked" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "The client may not use this session." ;
	fixp:sbe_value "2" .
fixp:FixpEstablishmentRejectCode\#Unnegotiated a owl:Class ;
	rdfs:label "Unnegotiated" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "The session was never negotiated, or it has been finalized and needs a new negotiation." ;
	fixp:sbe_value "0" .
fixp:FixpEstablishmentRejectCode\#Unspecified a owl:Class ;
	rdfs:label "Unspecified" ;
	rdfs:subClassOf fixp:FixpEstablishmentRejectCode ;
	skos:definition "Some reason the other values do not name." ;
	fixp:sbe_value "5" .
fixp:FixpEstablishmentRejectCode a owl:Class ;
	rdfs:label "FixpEstablishmentRejectCode" ;
	owl:unionOf _:c14n276 ;
	skos:definition "Why a server would not bind the session to this transport." ;
	skos:inScheme fixp:schema\/fixp_core ;
	linkml:permissible_values fixp:FixpEstablishmentRejectCode\#AlreadyEstablished , fixp:FixpEstablishmentRejectCode\#Credentials , fixp:FixpEstablishmentRejectCode\#KeepaliveInterval , fixp:FixpEstablishmentRejectCode\#SessionBlocked , fixp:FixpEstablishmentRejectCode\#Unnegotiated , fixp:FixpEstablishmentRejectCode\#Unspecified ;
	fixp:sbe_encoding_type "uint8" ;
	fixp:sbe_name "EstablishmentRejectCode" .
fixp:FixpExchange a owl:Class ;
	rdfs:label "FixpExchange" ;
	rdfs:subClassOf _:c14n174 , _:c14n201 , _:c14n207 , _:c14n208 , _:c14n238 , _:c14n25 , _:c14n277 , _:c14n280 , _:c14n283 , _:c14n328 , _:c14n44 , _:c14n51 , _:c14n53 , _:c14n80 ;
	skos:definition "The messages of one session in the order they were sent, as a test case, a worked example or a captured log." ;
	skos:inScheme fixp:schema\/fixp_exchange .
fixp:FixpExchangeStep a owl:Class ;
	rdfs:label "FixpExchangeStep" ;
	rdfs:subClassOf _:c14n110 , _:c14n123 , _:c14n172 , _:c14n197 , _:c14n252 , _:c14n314 , _:c14n52 , _:c14n7 , _:c14n71 ;
	owl:disjointUnionOf _:c14n200 ;
	skos:definition "One step: a FIXP message, or a run of application messages whose content FIXP does not define, and the side that sent it." ;
	skos:inScheme fixp:schema\/fixp_exchange .
fixp:FixpFinishedReceiving a owl:Class ;
	rdfs:label "FixpFinishedReceiving" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n134 , _:c14n178 , _:c14n288 ;
	skos:definition "Answers FinishedSending once the last message of the peer's flow has been processed. After it the session is finalized and its identifier is spent." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_of "peer" ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "true" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "FinishedReceiving" ;
	fixp:sbe_template_id "16" .
fixp:FixpFinishedSending a owl:Class ;
	rdfs:label "FixpFinishedSending" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n0 , _:c14n14 , _:c14n183 , _:c14n281 , _:c14n286 , _:c14n330 ;
	skos:definition "Says that the sender's flow has carried its last application message, which begins finalization. It is repeated as the heartbeat until the answer comes." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_of "own" ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "true" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "FinishedSending" ;
	fixp:sbe_template_id "15" .
fixp:FixpFlowType\#Idempotent a owl:Class ;
	rdfs:label "Idempotent" ;
	rdfs:subClassOf fixp:FixpFlowType ;
	skos:definition "No message takes effect twice; the sender hears of a gap and its application decides what to resend." ;
	fixp:sbe_value "1" .
fixp:FixpFlowType\#None a owl:Class ;
	rdfs:label "None" ;
	rdfs:subClassOf fixp:FixpFlowType ;
	skos:definition "This side sends no application messages at all." ;
	fixp:sbe_value "3" .
fixp:FixpFlowType\#Recoverable a owl:Class ;
	rdfs:label "Recoverable" ;
	rdfs:subClassOf fixp:FixpFlowType ;
	skos:definition "Every message arrives once and in order; the receiver asks for any gap to be sent again." ;
	fixp:sbe_value "0" .
fixp:FixpFlowType\#Unsequenced a owl:Class ;
	rdfs:label "Unsequenced" ;
	rdfs:subClassOf fixp:FixpFlowType ;
	skos:definition "Messages carry no sequence number, and none is ever resent." ;
	fixp:sbe_value "2" .
fixp:FixpFlowType a owl:Class ;
	rdfs:label "FixpFlowType" ;
	owl:unionOf _:c14n85 ;
	skos:definition "How surely a flow is delivered. A flow is what one side of a session sends the other, leaving out session messages." ;
	skos:inScheme fixp:schema\/fixp_core ;
	skos:note "The values are listed from the strongest guarantee to none." ;
	linkml:permissible_values fixp:FixpFlowType\#Idempotent , fixp:FixpFlowType\#None , fixp:FixpFlowType\#Recoverable , fixp:FixpFlowType\#Unsequenced ;
	fixp:sbe_encoding_type "uint8" ;
	fixp:sbe_name "FlowType" .
fixp:FixpMessage a owl:Class ;
	rdfs:label "FixpMessage" ;
	rdfs:subClassOf _:c14n118 , _:c14n138 , _:c14n176 , _:c14n266 ;
	skos:definition "One FIXP message, as its fields would be read from the wire before or after encoding." ;
	skos:inScheme fixp:schema\/fixp_core ;
	skos:note "The FIXP files define each message as an SBE message template, which lmodel/fix-sbe models as SbeMessageV1, and as an Orchestra message, which lmodel/fix-orchestra models as OrchestraMessageV10. A record of those classes defines a kind of message; an instance of this class is one message of that kind." , "The annotations of each subclass name its template id and its name in the SBE schema, the stage the summary in section 6 gives it, which side sends it, and the flow types it may appear on." ;
	skos:relatedMatch fix_orchestra:OrchestraMessageV10 , fix_sbe:SbeMessageV1 .
fixp:FixpMessageTemplate a owl:Class ;
	rdfs:label "FixpMessageTemplate" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n129 , _:c14n155 , _:c14n167 , _:c14n206 , _:c14n233 , _:c14n267 , _:c14n28 , _:c14n298 , _:c14n319 , _:c14n322 , _:c14n332 , _:c14n79 ;
	skos:definition "Hands the peer a template or schema it needs to read messages in an encoding that templates drive. There is no fixed moment for sending it." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	skos:note "A publisher does well to repeat it for late listeners. On a shared transport it applies to every session there." ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "true" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "MessageTemplate" ;
	fixp:sbe_template_id "19" .
fixp:FixpMulticastFlowType\#Idempotent a owl:Class ;
	rdfs:label "Idempotent" ;
	rdfs:subClassOf fixp:FixpMulticastFlowType ;
	skos:definition "Sequenced, so a listener can see a loss, but nothing lost comes back." ;
	fixp:sbe_value "1" .
fixp:FixpMulticastFlowType\#Recoverable a owl:Class ;
	rdfs:label "Recoverable" ;
	rdfs:subClassOf fixp:FixpMulticastFlowType ;
	skos:definition "Sequenced; a listener gets a lost message back over a separate unicast session." ;
	fixp:sbe_value "0" .
fixp:FixpMulticastFlowType a owl:Class ;
	rdfs:label "FixpMulticastFlowType" ;
	owl:unionOf _:c14n12 ;
	skos:definition "The delivery guarantee a multicast topic announces for its flow." ;
	skos:inScheme fixp:schema\/fixp_core ;
	skos:note "Section 5 and the repository file allow these two values. Section 3 allows a multicast Idempotent alone, and the SBE schema reuses the four-value FlowType; tests/upstream_departures.yaml records both." ;
	linkml:permissible_values fixp:FixpMulticastFlowType\#Idempotent , fixp:FixpMulticastFlowType\#Recoverable ;
	fixp:repository_code_set "FlowCodeSet" .
fixp:FixpNanotime a rdfs:Datatype ;
	owl:equivalentClass _:c14n173 .
fixp:FixpNegotiate a owl:Class ;
	rdfs:label "FixpNegotiate" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n108 , _:c14n125 , _:c14n151 , _:c14n189 , _:c14n202 , _:c14n239 , _:c14n309 , _:c14n42 , _:c14n61 , _:c14n68 , _:c14n86 , _:c14n87 ;
	skos:definition "A client's request to create a session under an identifier it has never used, stating the flow type it will send." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	fixp:fixp_flow_types "Recoverable Idempotent Unsequenced None" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "client" ;
	fixp:sbe_name "Negotiate" ;
	fixp:sbe_template_id "1" .
