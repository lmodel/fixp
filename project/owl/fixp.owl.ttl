    rdfs:subClassOf [ owl:unionOf ( fixp:Applied fixp:Context fixp:Establish fixp:EstablishmentAck fixp:EstablishmentReject fixp:FinishedReceiving fixp:FinishedSending fixp:MessageTemplate fixp:Negotiate fixp:NegotiationReject fixp:NegotiationResponse fixp:NotApplied fixp:RestransmitReject fixp:Retransmission fixp:RetransmitRequest fixp:Sequence fixp:Terminate fixp:Topic fixp:UnsequencedHeartbeat ) ] ;
