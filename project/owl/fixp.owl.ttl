fixp:FixpRetransmitReject a owl:Class ;
	rdfs:label "FixpRetransmitReject" ;
	rdfs:subClassOf fixp:FixpMessage , _:c14n107 , _:c14n119 , _:c14n127 , _:c14n135 , _:c14n140 , _:c14n159 , _:c14n180 , _:c14n212 , _:c14n24 , _:c14n259 , _:c14n274 , _:c14n295 ;
	skos:definition "Refuses a RetransmitRequest, with a code saying why." ;
	skos:inScheme fixp:schema\/fixp_messages ;
	skos:note "The resource files and section 4's table spell its name RestransmitReject. The summary in section 6 does not list it; it answers a RetransmitRequest, so it belongs to recoverable flows." ;
	fixp:fixp_flow_of "own" ;
	fixp:fixp_flow_types "Recoverable" ;
	fixp:fixp_multicast "false" ;
	fixp:fixp_sent_by "any" ;
	fixp:sbe_name "RestransmitReject" ;
	fixp:sbe_template_id "13" .
fixp:FixpRetransmitRejectCode\#InvalidSession a owl:Class ;
	rdfs:label "InvalidSession" ;
	rdfs:subClassOf fixp:FixpRetransmitRejectCode ;
	skos:definition "The session is unknown, or the one asking may not read it." ;
	fixp:sbe_value "1" .
fixp:FixpRetransmitRejectCode\#OutOfRange a owl:Class ;
	rdfs:label "OutOfRange" ;
	rdfs:subClassOf fixp:FixpRetransmitRejectCode ;
	skos:definition "The range asked for runs past the sequence numbers sent so far." ;
	fixp:sbe_value "0" .
fixp:FixpRetransmitRejectCode\#RequestLimitExceeded a owl:Class ;
	rdfs:label "RequestLimitExceeded" ;
	rdfs:subClassOf fixp:FixpRetransmitRejectCode ;
	skos:definition "The request asks for more messages than the sender resends at once." ;
	fixp:sbe_value "2" .
fixp:FixpRetransmitRejectCode a owl:Class ;
