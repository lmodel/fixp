@prefix common_domain_model: <https://w3id.org/lmodel/common-domain-model/elements/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fix_orchestra: <https://w3id.org/lmodel/fix-orchestra/elements/> .
@prefix fix_sbe: <https://w3id.org/lmodel/fix-sbe/elements/> .
@prefix fixp: <https://w3id.org/lmodel/fixp/> .
@prefix fixr: <http://fixprotocol.io/2020/orchestra/repository/> .
@prefix fluxnova_bpm_platform: <https://w3id.org/lmodel/fluxnova-bpm-platform/elements/> .
@prefix gist_linkml: <https://w3id.org/lmodel/gist/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sbe: <http://fixprotocol.io/2016/sbe/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/fixp.owl.ttl> a owl:Ontology ;
    rdfs:label "fixp" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://github.com/FIXTradingCommunity/fixp-specification> ;
    dcterms:title "FIXP (FIX Performance) Session Protocol" ;
    pav:version "FIX.5.0SP2" ;
    rdfs:seeAlso <https://github.com/FIXTradingCommunity/fixp-specification>,
        <https://lmodel.github.io/fixp>,
        <https://www.fixtrading.org/standards/fixp/> ;
    skos:definition "LinkML schema for the FIX Performance (FIXP) Session Protocol, auto-generated from the upstream specification artifacts (FixRepositoryForFIXP.xml, SBEschemaForFIXP.xml, OrchestraForFIXP.xml)." ;
    skos:editorialNote "(c) Copyright FIX Protocol Limited. Creative Commons Attribution-NoDerivatives 4.0 International Public License (CC BY-ND 4.0) applies to the upstream FIXP specification.",
        "This LinkML schema is auto-generated by scripts/schema_to_linkml.py - edit the script (or the upstream XMLs) and re-run; do not edit this file by hand." ;
    fixp:fix_version "FIX.5.0SP2" ;
    fixp:sbe_byte_order "littleEndian" ;
    fixp:sbe_package "FIXP" ;
    fixp:sbe_schema_id "2748" ;
    fixp:sources "FixRepositoryForFIXP.xml, SBEschemaForFIXP.xml, OrchestraForFIXP.xml" .

fixp:FIXAmt a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXBoolean a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "[YN]{1}" ] ) ] ) ] .

fixp:FIXChar a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXCountry a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern ".{2}" ] ) ] ) ] .

fixp:FIXCurrency a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern ".{3}" ] ) ] ) ] .

fixp:FIXDayOfMonth a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXExchange a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern ".*" ] ) ] ) ] .

fixp:FIXFloat a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXLanguage a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXLength a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXLocalMktDate a rdfs:Datatype ;
    owl:equivalentClass xsd:date .

fixp:FIXLocalMktTime a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXMonthYear a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "\\d{4}(0|1)\\d([0-3wW]\\d)?" ] ) ] ) ] .

fixp:FIXMultipleCharValue a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "[A-Za-z0-9](\\s[A-Za-z0-9])*" ] ) ] ) ] .

fixp:FIXMultipleStringValue a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern ".+(\\s.+)*" ] ) ] ) ] .

fixp:FIXNumInGroup a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXPattern a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXPercentage a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXPrice a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXPriceOffset a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXQty a rdfs:Datatype ;
    owl:equivalentClass xsd:float .

fixp:FIXReserved1000Plus a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXReserved100Plus a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXReserved4000Plus a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXSeqNum a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXTZTimeOnly a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXTZTimestamp a rdfs:Datatype ;
    owl:equivalentClass xsd:dateTime .

fixp:FIXTagNum a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FIXTenor a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "[DMWY](\\d)+" ] ) ] ) ] .

fixp:FIXUTCDateOnly a rdfs:Datatype ;
    owl:equivalentClass xsd:date .

fixp:FIXUTCTimeOnly a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXUTCTimestamp a rdfs:Datatype ;
    owl:equivalentClass xsd:dateTime .

fixp:FIXXID a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXXIDREF a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:FIXXMLData a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fixp:SbeCardinal a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:SbeDeltaMillisecs a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:SbeNanotime a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:SbeOrdinal a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:SbeUUID a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fixp:FixpSessionExchange a owl:Class ;
    rdfs:label "FixpSessionExchange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:messages ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:rights ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FixpSessionMessage ;
            owl:onProperty fixp:messages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:rights ] ;
    skos:broadMatch gist_linkml:Event ;
    skos:definition "Top-level container for a FIXP session exchange - holds an ordered list of session messages plus optional metadata." ;
    skos:exactMatch fixp:FixpSessionExchange ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    skos:relatedMatch common_domain_model:Workflow,
        fix_orchestra:MessageType,
        fix_sbe:MessageSchemaV1 .

fixp:SbeCharacterStringComposite a owl:Class ;
    rdfs:label "SbeCharacterStringComposite" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:var_data ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fixp:var_data ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:var_data ] ;
    skos:closeMatch fix_sbe:CompositeDataTypeV1 ;
    skos:definition "Variable length text" ;
    skos:exactMatch sbe:CharacterString,
        fixp:SbeCharacterStringComposite ;
    skos:inScheme <https://w3id.org/lmodel/fixp> .

fixp:SbeMessageHeaderComposite a owl:Class ;
    rdfs:label "SbeMessageHeaderComposite" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:schema_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:block_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:template_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:schema_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:schema_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:block_length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:block_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:schema_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:template_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:schema_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:template_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:schema_version ] ;
    skos:closeMatch fix_sbe:CompositeDataTypeV1 ;
    skos:definition "Message identifiers and length of message root" ;
    skos:exactMatch sbe:messageHeader,
        fixp:SbeMessageHeaderComposite ;
    skos:inScheme <https://w3id.org/lmodel/fixp> .

fixp:SbeObjectComposite a owl:Class ;
    rdfs:label "SbeObjectComposite" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:var_data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:var_data ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty fixp:var_data ] ;
    skos:closeMatch fix_sbe:CompositeDataTypeV1 ;
    skos:definition "Variable length data, also know as octect string" ;
    skos:exactMatch sbe:Object,
        fixp:SbeObjectComposite ;
    skos:inScheme <https://w3id.org/lmodel/fixp> .

fixp:Applied a owl:Class ;
    rdfs:label "Applied" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:count ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:from_seq_no ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:from_seq_no ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:from_seq_no ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:count ],
        fixp:FixpSessionMessage ;
    skos:definition "FIXP session message 'Applied'." ;
    skos:exactMatch sbe:Applied,
        fixr:Applied,
        fixp:Applied ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    fixp:fix_category "Session" ;
    fixp:fix_message_id "17" ;
    fixp:fix_section "Session" ;
    fixp:orchestra_message_id "17" ;
    fixp:sbe_template_id "17" ;
    fixp:sources "fix_repo, sbe, orchestra" .

<https://w3id.org/lmodel/fixp/ClientFlowCodeSet#IDEMPOTENT> a owl:Class ;
    rdfs:label "IDEMPOTENT" ;
    dcterms:title "Idempotent" ;
    rdfs:subClassOf fixp:ClientFlowCodeSet ;
    fixp:fixr_value "1" .

<https://w3id.org/lmodel/fixp/ClientFlowCodeSet#NONE> a owl:Class ;
    rdfs:label "NONE" ;
    dcterms:title "None" ;
    rdfs:subClassOf fixp:ClientFlowCodeSet ;
    fixp:fixr_value "3" .

<https://w3id.org/lmodel/fixp/ClientFlowCodeSet#RECOVERABLE> a owl:Class ;
    rdfs:label "RECOVERABLE" ;
    dcterms:title "Recoverable" ;
    rdfs:subClassOf fixp:ClientFlowCodeSet ;
    fixp:fixr_value "0" .

<https://w3id.org/lmodel/fixp/ClientFlowCodeSet#UNSEQUENCED> a owl:Class ;
    rdfs:label "UNSEQUENCED" ;
    dcterms:title "Unsequenced" ;
    rdfs:subClassOf fixp:ClientFlowCodeSet ;
    fixp:fixr_value "2" .

<https://w3id.org/lmodel/fixp/ClientFlowFieldEnum#IDEMPOTENT> a owl:Class ;
    rdfs:label "IDEMPOTENT" ;
    dcterms:title "Idempotent" ;
    rdfs:subClassOf fixp:ClientFlowFieldEnum ;
    fixp:fix_value "1" .

<https://w3id.org/lmodel/fixp/ClientFlowFieldEnum#NONE> a owl:Class ;
    rdfs:label "NONE" ;
    dcterms:title "None" ;
    rdfs:subClassOf fixp:ClientFlowFieldEnum ;
    fixp:fix_value "3" .

<https://w3id.org/lmodel/fixp/ClientFlowFieldEnum#RECOVERABLE> a owl:Class ;
    rdfs:label "RECOVERABLE" ;
    dcterms:title "Recoverable" ;
    rdfs:subClassOf fixp:ClientFlowFieldEnum ;
    fixp:fix_value "0" .

<https://w3id.org/lmodel/fixp/ClientFlowFieldEnum#UNSEQUENCED> a owl:Class ;
    rdfs:label "UNSEQUENCED" ;
    dcterms:title "Unsequenced" ;
    rdfs:subClassOf fixp:ClientFlowFieldEnum ;
    fixp:fix_value "2" .

fixp:Context a owl:Class ;
    rdfs:label "Context" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXString ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:next_seq_no ],
        fixp:FixpSessionMessage ;
    skos:definition "FIXP session message 'Context'." ;
    skos:exactMatch sbe:Context,
        fixr:Context,
        fixp:Context ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    fixp:fix_category "Session" ;
    fixp:fix_message_id "9" ;
    fixp:fix_section "Session" ;
    fixp:orchestra_message_id "9" ;
    fixp:sbe_template_id "9" ;
    fixp:sources "fix_repo, sbe, orchestra" .

fixp:Establish a owl:Class ;
    rdfs:label "Establish" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXString ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:credentials ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXData ;
            owl:onProperty fixp:credentials ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:credentials ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:session_id ],
        fixp:FixpSessionMessage ;
    skos:definition "FIXP session message 'Establish'." ;
    skos:exactMatch sbe:Establish,
        fixr:Establish,
        fixp:Establish ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    skos:relatedMatch gist_linkml:Commitment ;
    fixp:fix_category "Session" ;
    fixp:fix_message_id "5" ;
    fixp:fix_section "Session" ;
    fixp:orchestra_message_id "5" ;
    fixp:sbe_template_id "5" ;
    fixp:sources "fix_repo, sbe, orchestra" .

fixp:EstablishmentAck a owl:Class ;
    rdfs:label "EstablishmentAck" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:request_timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:request_timestamp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:keepalive_interval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:next_seq_no ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
            owl:onProperty fixp:request_timestamp ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXString ;
            owl:onProperty fixp:session_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fixp:next_seq_no ],
        fixp:FixpSessionMessage ;
    skos:definition "FIXP session message 'EstablishmentAck'." ;
    skos:exactMatch sbe:EstablishmentAck,
        fixr:EstablishmentAck,
        fixp:EstablishmentAck ;
    skos:inScheme <https://w3id.org/lmodel/fixp> ;
    fixp:fix_category "Session" ;
    fixp:fix_message_id "6" ;
    fixp:fix_section "Session" ;
    fixp:orchestra_message_id "6" ;
    fixp:sbe_template_id "6" ;
    fixp:sources "fix_repo, sbe, orchestra" .

fixp:EstablishmentReject a owl:Class ;
    rdfs:label "EstablishmentReject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fixp:establishment_reject_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixp:FIXInt ;
