	linkml:class_uri "https://w3id.org/lmodel/fixp/FixpApplied"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fixp/FixpApplied"^^xsd:anyURI ;
	linkml:description "An optional application message telling the party that sends an idempotent flow which of its operations took effect, where no business message already says so." ;
	linkml:is_a <https://w3id.org/lmodel/fixp/FixpMessage> ;
	linkml:slot_usage _:c14n332 ;
	linkml:slots <https://w3id.org/lmodel/fixp/FixpApplied_from_seq_no> , <https://w3id.org/lmodel/fixp/FixpApplied_message_count> , <https://w3id.org/lmodel/fixp/message_kind> .
