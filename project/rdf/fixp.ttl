	linkml:class_uri "https://w3id.org/lmodel/fixp/FixpUnsequencedHeartbeat"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/fixp/FixpUnsequencedHeartbeat"^^xsd:anyURI ;
