<https://w3id.org/lmodel/fixp/fixp_uuid> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://www.rfc-editor.org/rfc/rfc4122"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/fixp/schema/fixp_core"^^xsd:anyURI ;
	skos:note "On the wire it is 16 octets. The pattern checks the version digit and the variant bits that RFC 4122 sets for a random UUID." ;
