<https://w3id.org/lmodel/fixp/AlreadyEstablished> linkml:annotations _:c14n41 ;
	linkml:description "The server had already acknowledged a binding, so this request repeats it." .
<https://w3id.org/lmodel/fixp/Credentials> linkml:annotations _:c14n102 , _:c14n52 ;
	linkml:description "The server could not identify the client, or would not let it in." .
<https://w3id.org/lmodel/fixp/DuplicateId> linkml:annotations _:c14n53 ;
	linkml:description "The client chose a session identifier that is not new." .
<https://w3id.org/lmodel/fixp/Finished> linkml:annotations _:c14n341 ;
	linkml:description "An ordinary release, with no error." .
<https://w3id.org/lmodel/fixp/FixpApplied> OIO:inSubset <https://w3id.org/lmodel/fixp/fixp_transferring> ;
	a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/fixp/schema/fixp_messages"^^xsd:anyURI ;
	skos:note "Like any application message, it uses up one number in the sequence of the flow it travels on." ;
