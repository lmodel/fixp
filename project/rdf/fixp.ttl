<https://w3id.org/lmodel/fixp/fixp> dcterms:license "Apache-2.0" ;
	dcterms:source "https://github.com/FIXTradingCommunity/fixp-specification/tree/v1.0-STANDARD/v1-0-STANDARD"^^xsd:anyURI ;
	dcterms:title "FIX Performance Session Layer (FIXP)" ;
	pav:version "1.0" ;
	schema1:keywords "FIX" , "FIXP" , "session layer" , "trading" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/FIXTradingCommunity/fixp-specification"^^xsd:anyURI , "https://lmodel.github.io/fixp"^^xsd:anyURI ;
	skos:note "An exchange starts at FixpExchange, the tree root. A single message validates against its own class, such as FixpNegotiate, and a rules-of-engagement record against FixpRulesOfEngagement. upstream/ holds the specification's resource files unchanged, tests/test_coverage.py compares the modules with them, and scripts/check_upstream_release.py reports when they change." ;
	sh:declare _:c14n137 , _:c14n269 , _:c14n298 , _:c14n353 , _:c14n98 ;
	linkml:annotations _:c14n169 , _:c14n204 , _:c14n234 , _:c14n259 , _:c14n290 , _:c14n292 ;
	linkml:classes <https://w3id.org/lmodel/fixp/FixpApplied> , <https://w3id.org/lmodel/fixp/FixpContext> , <https://w3id.org/lmodel/fixp/FixpEstablish> , <https://w3id.org/lmodel/fixp/FixpEstablishmentAck> , <https://w3id.org/lmodel/fixp/FixpEstablishmentReject> , <https://w3id.org/lmodel/fixp/FixpExchange> , <https://w3id.org/lmodel/fixp/FixpExchangeStep> , <https://w3id.org/lmodel/fixp/FixpFinishedReceiving> , <https://w3id.org/lmodel/fixp/FixpFinishedSending> , <https://w3id.org/lmodel/fixp/FixpMessage> , <https://w3id.org/lmodel/fixp/FixpMessageTemplate> , <https://w3id.org/lmodel/fixp/FixpNegotiate> , <https://w3id.org/lmodel/fixp/FixpNegotiationReject> , <https://w3id.org/lmodel/fixp/FixpNegotiationResponse> , <https://w3id.org/lmodel/fixp/FixpNotApplied> , <https://w3id.org/lmodel/fixp/FixpRetransmission> , <https://w3id.org/lmodel/fixp/FixpRetransmitReject> , <https://w3id.org/lmodel/fixp/FixpRetransmitRequest> , <https://w3id.org/lmodel/fixp/FixpRulesOfEngagement> , <https://w3id.org/lmodel/fixp/FixpSequence> , <https://w3id.org/lmodel/fixp/FixpStackProfile> , <https://w3id.org/lmodel/fixp/FixpTerminate> , <https://w3id.org/lmodel/fixp/FixpTopic> , <https://w3id.org/lmodel/fixp/FixpUnsequencedHeartbeat> ;
	linkml:default_prefix "fixp" ;
	linkml:default_range <https://w3id.org/lmodel/fixp/string> ;
	linkml:description "A LinkML model of the FIX Performance Session Layer 1.0, the FIX Trading Community's session protocol for fast trading links. It describes FIXP's session messages, their fields and value lists, exchanges of those messages on one session, and the rules of engagement two parties agree on. A message is described by its fields, so the model works with any encoding." ;
	linkml:enums <https://w3id.org/lmodel/fixp/FixpEstablishmentRejectCode> , <https://w3id.org/lmodel/fixp/FixpFlowType> , <https://w3id.org/lmodel/fixp/FixpMulticastFlowType> , <https://w3id.org/lmodel/fixp/FixpNegotiationRejectCode> , <https://w3id.org/lmodel/fixp/FixpParty> , <https://w3id.org/lmodel/fixp/FixpRetransmitRejectCode> , <https://w3id.org/lmodel/fixp/FixpSessionKind> , <https://w3id.org/lmodel/fixp/FixpTerminationCode> ;
	linkml:id "https://w3id.org/lmodel/fixp"^^xsd:anyURI ;
	linkml:imports "./fixp_core"^^xsd:anyURI , "./fixp_engagement"^^xsd:anyURI , "./fixp_exchange"^^xsd:anyURI , "./fixp_messages"^^xsd:anyURI , "linkml:types"^^xsd:anyURI ;
