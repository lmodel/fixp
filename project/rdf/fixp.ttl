	linkml:is_a <https://w3id.org/lmodel/fixp/FixpMessage> ;
	linkml:slot_usage _:c14n273 ;
	linkml:slots <https://w3id.org/lmodel/fixp/message_kind> .
<https://w3id.org/lmodel/fixp/FlowTypeNotSupported> linkml:annotations _:c14n220 ;
	linkml:description "The server does not offer the flow type the client asked to send." .
<https://w3id.org/lmodel/fixp/Idempotent> linkml:annotations _:c14n819 , _:c14n820 ;
	linkml:description "No message takes effect twice; the sender hears of a gap and its application decides what to resend." , "Sequenced, so a listener can see a loss, but nothing lost comes back." .
<https://w3id.org/lmodel/fixp/InvalidSession> linkml:annotations _:c14n15 ;
	linkml:description "The session is unknown, or the one asking may not read it." .
<https://w3id.org/lmodel/fixp/KeepaliveInterval> linkml:annotations _:c14n342 ;
	linkml:description "The client's keep-alive interval is outside what the server accepts." .
<https://w3id.org/lmodel/fixp/None> linkml:annotations _:c14n235 ;
	linkml:description "This side sends no application messages at all." .
<https://w3id.org/lmodel/fixp/OutOfRange> linkml:annotations _:c14n150 ;
	linkml:description "The range asked for runs past the sequence numbers sent so far." .
<https://w3id.org/lmodel/fixp/ReRequestInProgress> linkml:annotations _:c14n132 ;
	linkml:description "The peer asked again for messages while its earlier request was unanswered." .
<https://w3id.org/lmodel/fixp/ReRequestOutOfBounds> linkml:annotations _:c14n37 ;
	linkml:description "The peer asked again for messages outside the range sent." .
<https://w3id.org/lmodel/fixp/Recoverable> linkml:annotations _:c14n817 , _:c14n818 ;
	linkml:description "Every message arrives once and in order; the receiver asks for any gap to be sent again." , "Sequenced; a listener gets a lost message back over a separate unicast session." .
<https://w3id.org/lmodel/fixp/RequestLimitExceeded> linkml:annotations _:c14n364 ;
	linkml:description "The request asks for more messages than the sender resends at once." .
<https://w3id.org/lmodel/fixp/SessionBlocked> linkml:annotations _:c14n351 ;
	linkml:description "The client may not use this session." .
<https://w3id.org/lmodel/fixp/Unnegotiated> linkml:annotations _:c14n178 ;
	linkml:description "The session was never negotiated, or it has been finalized and needs a new negotiation." .
<https://w3id.org/lmodel/fixp/Unsequenced> linkml:annotations _:c14n31 ;
	linkml:description "Messages carry no sequence number, and none is ever resent." .
<https://w3id.org/lmodel/fixp/Unspecified> linkml:annotations _:c14n255 , _:c14n51 ;
	linkml:description "Some reason the other values do not name." .
<https://w3id.org/lmodel/fixp/UnspecifiedError> linkml:annotations _:c14n181 ;
	linkml:description "An error that the other values do not name." .
