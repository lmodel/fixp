<https://w3id.org/lmodel/fixp/FixpContext> OIO:inSubset <https://w3id.org/lmodel/fixp/fixp_transferring> ;
	a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/fixp/schema/fixp_messages"^^xsd:anyURI ;
