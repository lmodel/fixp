<https://w3id.org/lmodel/fixp/fixp_object> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/fixp/schema/fixp_core"^^xsd:anyURI ;
	skos:note "FIXP leaves the wire form to the encoding. Base64 (RFC 4648, section 4) is this schema's choice for writing the octets in YAML and JSON." ;
	linkml:annotations _:c14n282 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/fixp/FixpObject"^^xsd:anyURI ;
	linkml:description "Octets that FIXP passes through without reading them, written here in base64." ;
	linkml:pattern "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" ;
	linkml:typeof <https://w3id.org/lmodel/fixp/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#base64Binary"^^xsd:anyURI .
