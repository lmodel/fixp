      "prefix_prefix": "skos",
      "prefix_reference": "http://www.w3.org/2004/02/skos/core#"
    },
    {
      "prefix_prefix": "schema",
      "prefix_reference": "http://schema.org/"
    },
    {
      "prefix_prefix": "dc",
      "prefix_reference": "http://purl.org/dc/elements/1.1/"
    },
    {
      "prefix_prefix": "dcterms",
      "prefix_reference": "http://purl.org/dc/terms/"
    },
    {
      "prefix_prefix": "fixr",
      "prefix_reference": "http://fixprotocol.io/2020/orchestra/repository/"
    },
    {
      "prefix_prefix": "sbe",
      "prefix_reference": "http://fixprotocol.io/2016/sbe/"
    },
    {
      "prefix_prefix": "common_domain_model",
      "prefix_reference": "https://w3id.org/lmodel/common-domain-model/elements/"
    },
    {
      "prefix_prefix": "fix_orchestra",
      "prefix_reference": "https://w3id.org/lmodel/fix-orchestra/elements/"
    },
    {
      "prefix_prefix": "fix_sbe",
      "prefix_reference": "https://w3id.org/lmodel/fix-sbe/elements/"
    },
    {
      "prefix_prefix": "fluxnova_bpm_platform",
      "prefix_reference": "https://w3id.org/lmodel/fluxnova-bpm-platform/elements/"
    },
    {
      "prefix_prefix": "gist_linkml",
      "prefix_reference": "https://w3id.org/lmodel/gist/"
    }
  ],
  "default_prefix": "fixp",
  "default_range": "string",
  "subsets": [
    {
      "name": "fixp_session_messages",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpSessionMessages",
      "description": "FIXP point-to-point and multicast session-layer messages (Negotiate, Establish, Sequence, Retransmit*, ...).",
      "from_schema": "https://w3id.org/lmodel/fixp",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fix_base_types",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixBaseTypes",
      "description": "FIX base datatypes (int, String, UTCTimestamp, ...) carried over from the FIX Repository / Orchestra. Each type is annotated with the recommended protobuf scalar via the proto_scalar annotation.",
      "from_schema": "https://w3id.org/lmodel/fixp",
      "@type": "SubsetDefinition"
    },
    {
      "name": "sbe_types",
      "definition_uri": "https://w3id.org/lmodel/fixp/SbeTypes",
      "description": "Simple Binary Encoding (SBE) primitive types and composites used by the FIXP wire format.",
      "from_schema": "https://w3id.org/lmodel/fixp",
      "@type": "SubsetDefinition"
    },
    {
      "name": "orchestra_code_sets",
      "definition_uri": "https://w3id.org/lmodel/fixp/OrchestraCodeSets",
      "description": "FIX Orchestra codeSets (enumerations) supplying stable, named identifiers for the FIX field enums (e.g. ClientFlowCodeSet, NegotiationRejectCodeCodeSet).",
      "from_schema": "https://w3id.org/lmodel/fixp",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fix_field_enums",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixFieldEnums",
      "description": "Inline FIX field enumerations synthesised from FixRepository <field><enum/></field> blocks when no Orchestra codeSet name is available.",
      "from_schema": "https://w3id.org/lmodel/fixp",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "FIXInt",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXInt",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:integer",
          "@type": "Annotation"
        }
      ],
      "description": "FIX int base datatype. Sequence of digits without commas or decimals and optional sign character (ASCII characters \"-\" and \"0\" - \"9\" ). The sign character utilizes one byte (i.e. positive int is \"99999\" while negative int is \"-99999\"). Note that int values may contain leading zeros (e.g. \"00023\" = \"23\"). Example: 723 in field 21 would be mapped int as |21=723|. -723 in field 12 would be mapped int as |12=-723|.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:int",
        "fix_orchestra:FIXInt"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXInt",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLength",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXLength",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:nonNegativeInteger",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Length datatype (extends int). int field representing the length in bytes. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Length",
        "fix_orchestra:FIXLength"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXLength",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTagNum",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXTagNum",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:nonNegativeInteger",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TagNum datatype (extends int). int field representing a field's tag number when using FIX \"Tag=Value\" syntax. Value must be positive and may not contain leading zeros.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:TagNum",
        "fix_orchestra:FIXTagNum"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXTagNum",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXSeqNum",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXSeqNum",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:positiveInteger",
          "@type": "Annotation"
        }
      ],
      "description": "FIX SeqNum datatype (extends int). int field representing a message sequence number. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:SeqNum",
        "fix_orchestra:FIXSeqNum"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXSeqNum",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXNumInGroup",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXNumInGroup",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX NumInGroup datatype (extends int). int field representing the number of entries in a repeating group. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:NumInGroup",
        "fix_orchestra:FIXNumInGroup"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXNumInGroup",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXDayOfMonth",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXDayOfMonth",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX DayOfMonth datatype (extends int). int field representing a day during a particular monthy (values 1 to 31).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:DayOfMonth",
        "fix_orchestra:FIXDayOfMonth"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXDayOfMonth",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXFloat",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXFloat",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "double",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX float base datatype. Sequence of digits with optional decimal point and sign character (ASCII characters \"-\", \"0\" - \"9\" and \".\"); the absence of the decimal point within the string will be interpreted as the float representation of an integer value. All float fields must accommodate up to fifteen significant digits. The number of decimal places used should be a factor of business/market needs and mutual agreement between counterparties. Note that float values may contain leading zeros (e.g. \"00023.23\" = \"23.23\") and may contain or omit trailing zeros after the decimal point (e.g. \"23.0\" = \"23.0000\" = \"23\" = \"23.\"). Note that fields which are derived from float may contain negative values unless explicitly specified otherwise.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:float",
        "fix_orchestra:FIXFloat"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXFloat",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXQty",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXQty",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Qty datatype (extends float). float field capable of storing either a whole number (no decimal places) of \"shares\" (securities denominated in whole units) or a decimal value containing decimal places for non-share quantity asset classes (securities denominated in fractional units).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Qty",
        "fix_orchestra:FIXQty"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXQty",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPrice",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXPrice",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Price datatype (extends float). float field representing a price. Note the number of decimal places may vary. For certain asset classes prices may be negative values. For example, prices for options strategies can be negative under certain market conditions. Refer to Volume 7: FIX Usage by Product for asset classes that support negative price values. Example: Strk=\"47.50\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Price",
        "fix_orchestra:FIXPrice"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXPrice",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPriceOffset",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXPriceOffset",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX PriceOffset datatype (extends float). float field representing a price offset, which can be mathematically added to a \"Price\". Note the number of decimal places may vary and some fields such as LastForwardPoints may be negative.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:PriceOffset",
        "fix_orchestra:FIXPriceOffset"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXPriceOffset",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXAmt",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXAmt",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Amt datatype (extends float). float field typically representing a Price times a Qty Example: Amt=\"6847.00\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Amt",
        "fix_orchestra:FIXAmt"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXAmt",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPercentage",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXPercentage",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "double",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:decimal",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Percentage datatype (extends float). float field representing a percentage (e.g. 0.05 represents 5% and 0.9525 represents 95.25%). Note the number of decimal places may vary.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Percentage",
        "fix_orchestra:FIXPercentage"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fixp/FIXPercentage",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXChar",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXChar",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX char base datatype. Single character value, can include any alphanumeric character or punctuation except the delimiter. All char fields are case sensitive (i.e. m != M).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:char",
        "fix_orchestra:FIXChar"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXChar",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXBoolean",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXBoolean",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "bool",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Boolean datatype (extends char). char field containing one of two values: 'Y' = True/Yes 'N' = False/No",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Boolean",
        "fix_orchestra:FIXBoolean"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXBoolean",
      "pattern": "[YN]{1}",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXString",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXString",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX String base datatype. Alpha-numeric free format strings, can include any character or punctuation except the delimiter. All String fields are case sensitive (i.e. morstatt != Morstatt).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:String",
        "fix_orchestra:FIXString"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXString",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXMultipleCharValue",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXMultipleCharValue",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX MultipleCharValue datatype (extends String). string field containing one or more space delimited single character values (e.g. |18=2 A F| ).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:MultipleCharValue",
        "fix_orchestra:FIXMultipleCharValue"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXMultipleCharValue",
      "pattern": "[A-Za-z0-9](\\s[A-Za-z0-9])*",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXMultipleStringValue",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXMultipleStringValue",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX MultipleStringValue datatype (extends String). string field containing one or more space delimited multiple character values (e.g. |277=AV AN A| ).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:MultipleStringValue",
        "fix_orchestra:FIXMultipleStringValue"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXMultipleStringValue",
      "pattern": ".+(\\s.+)*",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXCountry",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXCountry",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Country datatype (extends String). string field representing a country using ISO 3166 Country code (2 character) values (see Appendix 6-B).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Country",
        "fix_orchestra:FIXCountry"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXCountry",
      "pattern": ".{2}",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXCurrency",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXCurrency",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Currency datatype (extends String). string field representing a currency type using ISO 4217 Currency code (3 character) values (see Appendix 6-A). Example: StrkCcy=\"USD\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Currency",
        "fix_orchestra:FIXCurrency"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXCurrency",
      "pattern": ".{3}",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXExchange",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXExchange",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Exchange datatype (extends String). string field representing a market or exchange using ISO 10383 Market Identifier Code (MIC) values (see\"Appendix 6-C).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Exchange",
        "fix_orchestra:FIXExchange"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXExchange",
      "pattern": ".*",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXMonthYear",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXMonthYear",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX MonthYear datatype (extends String). string field representing month of a year. An optional day of the month can be appended or an optional week code. Valid formats: YYYYMM YYYYMMDD YYYYMMWW Valid values: YYYY = 0000-9999; MM = 01-12; DD = 01-31; WW = w1, w2, w3, w4, w5. Example: MonthYear=\"200303\", MonthYear=\"20030320\", MonthYear=\"200303w2\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:MonthYear",
        "fix_orchestra:FIXMonthYear"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXMonthYear",
      "pattern": "\\d{4}(0|1)\\d([0-3wW]\\d)?",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXUTCTimestamp",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXUTCTimestamp",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Timestamp",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:dateTime",
          "@type": "Annotation"
        }
      ],
      "description": "FIX UTCTimestamp datatype (extends String). string field representing time/date combination represented in UTC (Universal Time Coordinated, also known as \"GMT\") in either YYYYMMDD-HH:MM:SS (whole seconds) or YYYYMMDD-HH:MM:SS.sss* format, colons, dash, and period required. Valid values: YYYY = 0000-9999, MM = 01-12, DD = 01-31, HH = 00-23, MM = 00-59, SS = 00-60 (60 only if UTC leap second), sss* fractions of seconds. The fractions of seconds may be empty when no fractions of seconds are conveyed (in such a case the period is not conveyed), it may include 3 digits to convey milliseconds, 6 digits to convey microseconds, 9 digits to convey nanoseconds, 12 digits to convey picoseconds; Other number of digits may be used with bilateral agreement. Leap Seconds: Note that UTC includes corrections for leap seconds, which are inserted to account for slowing of the rotation of the earth. Leap second insertion is declared by the International Earth Rotation Service (IERS) and has, since 1972, only occurred on the night of Dec. 31 or Jun 30. The IERS considers March 31 and September 30 as secondary dates for leap second insertion, but has never utilized these dates. During a leap second insertion, a UTCTimestamp field may read \"19981231-23:59:59\", \"19981231-23:59:60\", \"19990101-00:00:00\". (see http://tycho.usno.navy.mil/leapsec.html) Example: TransactTime(60)=\"20011217-09:30:47.123\" millisecond TransactTime(60)=\"20011217-09:30:47.123456\" microseconds TransactTime(60)=\"20011217-09:30:47.123456789\" nanoseconds TransactTime(60)=\"20011217-09:30:47.123456789123\" picoseconds",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:UTCTimestamp",
        "fix_orchestra:FIXUTCTimestamp"
      ],
      "typeof": "datetime",
      "base": "XSDDateTime",
      "uri": "https://w3id.org/lmodel/fixp/FIXUTCTimestamp",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXUTCTimeOnly",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXUTCTimeOnly",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "TimeOnly",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:time",
          "@type": "Annotation"
        }
      ],
      "description": "FIX UTCTimeOnly datatype (extends String). string field representing time-only represented in UTC (Universal Time Coordinated, also known as \"GMT\") in either HH:MM:SS (whole seconds) or HH:MM:SS.sss* (milliseconds) format, colons, and period required. This special-purpose field is paired with UTCDateOnly to form a proper UTCTimestamp for bandwidth-sensitive messages. Valid values: HH = 00-23, MM = 00-59, SS = 00-60 (60 only if UTC leap second), sss* fractions of seconds. The fractions of seconds may be empty when no fractions of seconds are conveyed (in such a case the period is not conveyed), it may include 3 digits to convey milliseconds, 6 digits to convey microseconds, 9 digits to convey nanoseconds, 12 digits to convey picoseconds; Other number of digits may be used with bilateral agreement. Example: MDEntryTime(273)=\"13:20:00.123\"milliseconds MDEntryTime(273)=\"13:20:00.123456\" microseconds MDEntryTime(273)=\"13:20:00.123456789\" nanoseconds MDEntryTime(273)=\"13:20:00.123456789123\" picoseconds",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:UTCTimeOnly",
        "fix_orchestra:FIXUTCTimeOnly"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXUTCTimeOnly",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXUTCDateOnly",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXUTCDateOnly",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:date",
          "@type": "Annotation"
        }
      ],
      "description": "FIX UTCDateOnly datatype (extends String). string field representing Date represented in UTC (Universal Time Coordinated, also known as \"GMT\") in YYYYMMDD format. This special-purpose field is paired with UTCTimeOnly to form a proper UTCTimestamp for bandwidth-sensitive messages. Valid values: YYYY = 0000-9999, MM = 01-12, DD = 01-31. Example: MDEntryDate=\"20030910\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:UTCDateOnly",
        "fix_orchestra:FIXUTCDateOnly"
      ],
      "typeof": "date",
      "base": "XSDDate",
      "uri": "https://w3id.org/lmodel/fixp/FIXUTCDateOnly",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLocalMktDate",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXLocalMktDate",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:date",
          "@type": "Annotation"
        }
      ],
      "description": "FIX LocalMktDate datatype (extends String). string field representing a Date of Local Market (as opposed to UTC) in YYYYMMDD format. This is the \"normal\" date field used by the FIX Protocol. Valid values: YYYY = 0000-9999, MM = 01-12, DD = 01-31 Example: MaturityDate(541)=\"20150724\"",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:LocalMktDate",
        "fix_orchestra:FIXLocalMktDate"
      ],
      "typeof": "date",
      "base": "XSDDate",
      "uri": "https://w3id.org/lmodel/fixp/FIXLocalMktDate",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTZTimeOnly",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXTZTimeOnly",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "TimeOnly",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:time",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TZTimeOnly datatype (extends String). string field representing the time represented based on ISO 8601. This is the time with a UTC offset to allow identification of local time and timezone of that time. Format is HH:MM[:SS][Z | [ + | - hh[:mm]]] where HH = 00-23 hours, MM = 00-59 minutes, SS = 00-59 seconds, hh = 01-12 offset hours, mm = 00-59 offset minutes. Example: \"07:39Z\" is 07:39 UTC \"02:39-05\" is five hours behind UTC, thus Eastern Time \"15:39+08\" is eight hours ahead of UTC, Hong Kong/Singapore time \"13:09+05:30\" is 5.5 hours ahead of UTC, India time",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:TZTimeOnly",
        "fix_orchestra:FIXTZTimeOnly"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXTZTimeOnly",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTZTimestamp",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXTZTimestamp",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Timestamp",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:dateTime",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TZTimestamp datatype (extends String). string field representing a time/date combination representing local time with an offset to UTC to allow identification of local time and timezone offset of that time. The representation is based on ISO 8601. Format is YYYYMMDD-HH:MM:SS.sss*[Z | [ + | - hh[:mm]]] where YYYY = 0000 to 9999, MM = 01-12, DD = 01-31 HH = 00-23 hours, MM = 00-59 minutes, SS = 00-59 seconds, hh = 01-12 offset hours, mm = 00-59 offset minutes, sss* fractions of seconds. The fractions of seconds may be empty when no fractions of seconds are conveyed (in such a case the period is not conveyed), it may include 3 digits to convey milliseconds, 6 digits to convey microseconds, 9 digits to convey nanoseconds, 12 digits to convey picoseconds; Other number of digits may be used with bilateral agreement Example: \"20060901-07:39Z\" is 07:39 UTC on 1st of September 2006 \"20060901-02:39-05\" is five hours behind UTC, thus Eastern Time on 1st of September 2006 \"20060901-15:39+08\" is eight hours ahead of UTC, Hong Kong/Singapore time on 1st of September 2006 \"20060901-13:09+05:30\" is 5.5 hours ahead of UTC, India time on 1st of September 2006 Using decimal seconds: \"20060901-13:09.123+05:30\" milliseconds \"20060901-13:09.123456+05:30\" microseconds \"20060901-13:09.123456789+05:30\" nanoseconds \"20060901-13:09.123456789123+05:30\" picoseconds \"20060901-13:09.123456789Z\" nanoseconds UTC timezone",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:TZTimestamp",
        "fix_orchestra:FIXTZTimestamp"
      ],
      "typeof": "datetime",
      "base": "XSDDateTime",
      "uri": "https://w3id.org/lmodel/fixp/FIXTZTimestamp",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXData",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXData",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "bytes",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:base64Binary",
          "@type": "Annotation"
        }
      ],
      "description": "FIX data datatype (extends String). string field containing raw data with no format or content restrictions. Data fields are always immediately preceded by a length field. The length field should specify the number of bytes of the value of the data field (up to but not including the terminating SOH). Caution: the value of one of these fields may contain the delimiter (SOH) character. Note that the value specified for this field should be followed by the delimiter (SOH) character as all fields are terminated with an \"SOH\".",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:data",
        "fix_orchestra:FIXData"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXData",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPattern",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXPattern",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Pattern base datatype. Used to build on and provide some restrictions on what is allowed as valid values in fields that uses a base FIX data type and a pattern data type. The universe of allowable valid values for the field would then be the union of the base set of valid values and what is defined by the pattern data type. The pattern data type used by the field will retain its base FIX data type (e.g. String, int, char).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Pattern",
        "fix_orchestra:FIXPattern"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXPattern",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTenor",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXTenor",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Tenor",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Tenor datatype (extends Pattern). used to allow the expression of FX standard tenors in addition to the base valid enumerations defined for the field that uses this pattern data type. This pattern data type is defined as follows: Dx = tenor expression for \"days\", e.g. \"D5\", where \"x\" is any integer > 0 Mx = tenor expression for \"months\", e.g. \"M3\", where \"x\" is any integer > 0 Wx = tenor expression for \"weeks\", e.g. \"W13\", where \"x\" is any integer > 0 Yx = tenor expression for \"years\", e.g. \"Y1\", where \"x\" is any integer > 0",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Tenor",
        "fix_orchestra:FIXTenor"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXTenor",
      "pattern": "[DMWY](\\d)+",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved100Plus",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXReserved100Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:integer",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_min_inclusive",
          "value": "100",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Reserved100Plus datatype (extends Pattern). Values \"100\" and above are reserved for bilaterally agreed upon user defined enumerations.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Reserved100Plus",
        "fix_orchestra:FIXReserved100Plus"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXReserved100Plus",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved1000Plus",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXReserved1000Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:integer",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_min_inclusive",
          "value": "1000",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Reserved1000Plus datatype (extends Pattern). Values \"1000\" and above are reserved for bilaterally agreed upon user defined enumerations.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Reserved1000Plus",
        "fix_orchestra:FIXReserved1000Plus"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXReserved1000Plus",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved4000Plus",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXReserved4000Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:integer",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_min_inclusive",
          "value": "4000",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Reserved4000Plus datatype (extends Pattern). Values \"4000\" and above are reserved for bilaterally agreed upon user defined enumerations.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Reserved4000Plus",
        "fix_orchestra:FIXReserved4000Plus"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fixp/FIXReserved4000Plus",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXXMLData",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXXMLData",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX XMLData datatype (extends String). Contains an XML document raw data with no format or content restrictions. XMLData fields are always immediately preceded by a length field. The length field should specify the number of bytes of the value of the data field (up to but not including the terminating SOH).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:XMLData",
        "fix_orchestra:FIXXMLData"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXXMLData",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLanguage",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXLanguage",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:language",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Language datatype (extends String). Identifier for a national language - uses ISO 639-1 standard Example: en (English), es (spanish), etc.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:Language",
        "fix_orchestra:FIXLanguage"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXLanguage",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLocalMktTime",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXLocalMktTime",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "TimeOnly",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:time",
          "@type": "Annotation"
        }
      ],
      "description": "FIX LocalMktTime datatype (extends String). string field representing the time local to a particular market center. Used where offset to UTC varies throughout the year and the defining market center is identified in a corresponding field. Format is HH:MM:SS where HH = 00-23 hours, MM = 00-59 minutes, SS = 00-59 seconds. In general only the hour token is non-zero. Example: Example: 07:00:00",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:LocalMktTime",
        "fix_orchestra:FIXLocalMktTime"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXLocalMktTime",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXXID",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXXID",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:ID",
          "@type": "Annotation"
        }
      ],
      "description": "FIX XID datatype (extends String). The purpose of the XID datatype is to define a unique identifier that is global to a FIX message. An identifier defined using this datatype uniquely identifies its containing element, whatever its type and name is. The constraint added by this datatype is that the values of all the fields that have an ID datatype in a FIX message must be unique.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:XID",
        "fix_orchestra:FIXXID"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXXID",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXXIDREF",
      "definition_uri": "https://w3id.org/lmodel/fixp/FIXXIDREF",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        },
        {
          "tag": "xsd_base",
          "value": "xs:IDREF",
          "@type": "Annotation"
        }
      ],
      "description": "FIX XIDREF datatype (extends String). The XIDREF datatype defines a reference to an identifier defined by the XID datatype.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp",
      "exact_mappings": [
        "fixr:XIDREF",
        "fix_orchestra:FIXXIDREF"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fixp/FIXXIDREF",
      "@type": "TypeDefinition"
    },
    {
      "name": "SbeUUID",
      "definition_uri": "https://w3id.org/lmodel/fixp/SbeUUID",
      "annotations": [
        {
          "tag": "sbe_primitive_type",
          "value": "uint8",
          "@type": "Annotation"
        },
        {
