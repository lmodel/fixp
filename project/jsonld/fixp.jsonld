    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_u8",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpU8",
      "description": "A whole number from 0 to 255, held in eight unsigned bits.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "minimum_value": 0,
      "maximum_value": 255,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_u16",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpU16",
      "description": "A whole number from 0 to 65,535, held in 16 unsigned bits.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "minimum_value": 0,
      "maximum_value": 65535,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_u32",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpU32",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "cardinal",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_primitive_type",
          "value": "uint32",
          "@type": "Annotation"
        }
      ],
      "description": "A whole number from 0 to 4,294,967,295, held in 32 unsigned bits.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "minimum_value": 0,
      "maximum_value": 4294967295,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_u64",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpU64",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "ordinal",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_primitive_type",
          "value": "uint64",
          "@type": "Annotation"
        }
      ],
      "description": "A whole number from 0 to 18,446,744,073,709,551,615, held in 64 unsigned bits.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "minimum_value": 0,
      "maximum_value": 18446744073709551615,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_uuid",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpUuid",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "UUID",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_primitive_type",
          "value": "uint8",
          "@type": "Annotation"
        }
      ],
      "description": "A random UUID of RFC 4122's version 4, written as 32 hexadecimal digits in five groups joined by hyphens.",
      "comments": [
        "On the wire it is 16 octets. The pattern checks the version digit and the variant bits that RFC 4122 sets for a random UUID."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "see_also": [
        "https://www.rfc-editor.org/rfc/rfc4122"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$",
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_nanotime",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpNanotime",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "nanotime",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_primitive_type",
          "value": "uint64",
          "@type": "Annotation"
        }
      ],
      "description": "A moment, counted in nanoseconds since the Unix epoch and held in 64 unsigned bits.",
      "comments": [
        "The datatype table names no epoch; the usage examples in the specification's appendix A use the Unix epoch."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "unit": {
        "ucum_code": "ns",
        "@type": "UnitOfMeasure"
      },
      "minimum_value": 0,
      "maximum_value": 18446744073709551615,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_delta_millisecs",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpDeltaMillisecs",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "DeltaMillisecs",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_primitive_type",
          "value": "uint32",
          "@type": "Annotation"
        }
      ],
      "description": "A length of time in whole milliseconds, held in 32 unsigned bits.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "integer",
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "unit": {
        "ucum_code": "ms",
        "@type": "UnitOfMeasure"
      },
      "minimum_value": 0,
      "maximum_value": 4294967295,
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_object",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpObject",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "Object",
          "@type": "Annotation"
        }
      ],
      "description": "Octets that FIXP passes through without reading them, written here in base64.",
      "comments": [
        "FIXP leaves the wire form to the encoding. Base64 (RFC 4648, section 4) is this schema's choice for writing the octets in YAML and JSON."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#base64Binary",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "fixp_string",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpString",
      "annotations": [
        {
          "tag": "sbe_type",
          "value": "CharacterString",
          "@type": "Annotation"
        }
      ],
      "description": "Text, in UTF-8.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "FixpFlowType",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpFlowType",
      "annotations": [
        {
          "tag": "sbe_name",
          "value": "FlowType"
        },
        {
          "tag": "sbe_encoding_type",
          "value": "uint8"
        }
      ],
      "description": "How surely a flow is delivered. A flow is what one side of a session sends the other, leaving out session messages.",
      "comments": [
        "The values are listed from the strongest guarantee to none."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "Recoverable",
          "description": "Every message arrives once and in order; the receiver asks for any gap to be sent again.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "Idempotent",
          "description": "No message takes effect twice; the sender hears of a gap and its application decides what to resend.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        },
        {
          "text": "Unsequenced",
          "description": "Messages carry no sequence number, and none is ever resent.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ]
        },
        {
          "text": "None",
          "description": "This side sends no application messages at all.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "3"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpMulticastFlowType",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpMulticastFlowType",
      "annotations": [
        {
          "tag": "repository_code_set",
          "value": "FlowCodeSet"
        }
      ],
      "description": "The delivery guarantee a multicast topic announces for its flow.",
      "comments": [
        "Section 5 and the repository file allow these two values. Section 3 allows a multicast Idempotent alone, and the SBE schema reuses the four-value FlowType, which tests/upstream_departures.yaml records."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "Recoverable",
          "description": "Sequenced; a listener gets a lost message back over a separate unicast session.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "Idempotent",
          "description": "Sequenced, so a listener can see a loss, but nothing lost comes back.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpNegotiationRejectCode",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpNegotiationRejectCode",
      "annotations": [
        {
          "tag": "sbe_name",
          "value": "NegotiationRejectCode"
        },
        {
          "tag": "sbe_encoding_type",
          "value": "uint8"
        }
      ],
      "description": "Why a server refused to create a session.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "Credentials",
          "description": "The server could not identify the client, or would not let it in.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "FlowTypeNotSupported",
          "description": "The server does not offer the flow type the client asked to send.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        },
        {
          "text": "DuplicateId",
          "description": "The client chose a session identifier that is not new.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ]
        },
        {
          "text": "Unspecified",
          "description": "Some reason the other values do not name.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "3"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpEstablishmentRejectCode",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpEstablishmentRejectCode",
      "annotations": [
        {
          "tag": "sbe_name",
          "value": "EstablishmentRejectCode"
        },
        {
          "tag": "sbe_encoding_type",
          "value": "uint8"
        }
      ],
      "description": "Why a server would not bind the session to this transport.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "Unnegotiated",
          "description": "The session was never negotiated, or it has been finalized and needs a new negotiation.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "AlreadyEstablished",
          "description": "The server had already acknowledged a binding, so this request repeats it.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        },
        {
          "text": "SessionBlocked",
          "description": "The client may not use this session.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ]
        },
        {
          "text": "KeepaliveInterval",
          "description": "The client's keep-alive interval is outside what the server accepts.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "3"
            }
          ]
        },
        {
          "text": "Credentials",
          "description": "The server could not identify the client, or would not let it in.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "4"
            }
          ]
        },
        {
          "text": "Unspecified",
          "description": "Some reason the other values do not name.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "5"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpRetransmitRejectCode",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpRetransmitRejectCode",
      "annotations": [
        {
          "tag": "sbe_name",
          "value": "RetransmitRejectCode"
        },
        {
          "tag": "sbe_encoding_type",
          "value": "uint8"
        }
      ],
      "description": "Why a party will not resend the messages its peer asked for.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "OutOfRange",
          "description": "The range asked for runs past the sequence numbers sent so far.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "InvalidSession",
          "description": "The session is unknown, or the one asking may not read it.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        },
        {
          "text": "RequestLimitExceeded",
          "description": "The request asks for more messages than the sender resends at once.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpTerminationCode",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpTerminationCode",
      "annotations": [
        {
          "tag": "sbe_name",
          "value": "TerminationCode"
        },
        {
          "tag": "sbe_encoding_type",
          "value": "uint8"
        }
      ],
      "description": "Why a party releases a session from its transport.",
      "comments": [
        "The specification lists these values without saying what each one means, apart from ReRequestInProgress, so the descriptions read their names."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "permissible_values": [
        {
          "text": "Finished",
          "description": "An ordinary release, with no error.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ]
        },
        {
          "text": "UnspecifiedError",
          "description": "An error that the other values do not name.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ]
        },
        {
          "text": "ReRequestOutOfBounds",
          "description": "The peer asked again for messages outside the range sent.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ]
        },
        {
          "text": "ReRequestInProgress",
          "description": "The peer asked again for messages while its earlier request was unanswered.",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "3"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpSessionKind",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpSessionKind",
      "description": "The two forms of FIXP session.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_exchange",
      "permissible_values": [
        {
          "text": "point_to_point",
          "description": "A client and a server over a transport that carries messages both ways, with one flow each way.",
          "annotations": [
            {
              "tag": "fixp_section",
              "value": "4"
            }
          ]
        },
        {
          "text": "multicast",
          "description": "One publisher, one flow and many listeners, on a transport that only carries messages outward.",
          "annotations": [
            {
              "tag": "fixp_section",
              "value": "5"
            }
          ]
        }
      ]
    },
    {
      "name": "FixpParty",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpParty",
      "description": "The side that sends a step.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_exchange",
      "permissible_values": [
        {
          "text": "client",
          "description": "The party that opens a session with a server."
        },
        {
          "text": "server",
          "description": "The party that accepts the client's session."
        },
        {
          "text": "publisher",
          "description": "The only party that sends in a multicast."
        }
      ]
    }
  ],
