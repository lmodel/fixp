      "enum_uri": "fixp:SbeFlowType",
      "permissible_values": [
        {
          "text": "RECOVERABLE",
          "description": "Guarantees exactly-once message delivery",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "0"
            }
          ],
          "title": "Recoverable"
        },
        {
          "text": "IDEMPOTENT",
          "description": "Guarantees at-most-once delivery",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "1"
            }
          ],
          "title": "Idempotent"
        },
        {
          "text": "UNSEQUENCED",
          "description": "Best effort delivery",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "2"
            }
          ],
          "title": "Unsequenced"
        },
        {
          "text": "NONE",
          "description": "No application messages should be sent in one direction of a session",
          "annotations": [
            {
              "tag": "sbe_value",
              "value": "3"
            }
          ],
          "title": "None"
        }
      ]
    },
