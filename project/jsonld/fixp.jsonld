  ],
  "description": "A LinkML model of the FIX Performance Session Layer 1.0, the FIX Trading Community's session protocol for fast trading links. It describes FIXP's session messages, their fields and value lists, exchanges of those messages on one session, and the rules of engagement two parties agree on. A message is described by its fields, so the model works with any encoding.",
  "title": "FIX Performance Session Layer (FIXP)",
  "comments": [
    "An exchange starts at FixpExchange, the tree root. A single message validates against its own class, such as FixpNegotiate, and a rules-of-engagement record against FixpRulesOfEngagement. upstream/ holds the specification's resource files unchanged, tests/test_coverage.py compares the modules with them, and scripts/check_upstream_release.py reports when they change."
  ],
  "source": "https://github.com/FIXTradingCommunity/fixp-specification/tree/v1.0-STANDARD/v1-0-STANDARD",
  "see_also": [
    "https://lmodel.github.io/fixp",
    "https://github.com/FIXTradingCommunity/fixp-specification"
  ],
  "keywords": [
    "FIX",
    "FIXP",
    "session layer",
    "trading"
  ],
  "id": "https://w3id.org/lmodel/fixp",
  "version": "1.0",
  "imports": [
    "linkml:types",
    "./fixp_core",
    "./fixp_messages",
    "./fixp_exchange",
    "./fixp_engagement"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "fixp",
      "prefix_reference": "https://w3id.org/lmodel/fixp/"
    },
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "schema",
      "prefix_reference": "http://schema.org/"
    },
    {
      "prefix_prefix": "fix_sbe",
      "prefix_reference": "https://w3id.org/lmodel/fix-sbe/"
    },
    {
      "prefix_prefix": "fix_orchestra",
      "prefix_reference": "https://w3id.org/lmodel/fix-orchestra/"
    }
  ],
  "default_prefix": "fixp",
  "default_range": "string",
  "subsets": [
    {
      "name": "fixp_initialization",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpInitialization",
      "description": "Messages that create a session or announce a flow before any binding.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fixp_binding",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpBinding",
      "description": "Messages that bind a session to a transport.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fixp_transferring",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpTransferring",
      "description": "Messages sent while application messages flow.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fixp_unbinding",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpUnbinding",
      "description": "The message that releases a session from its transport.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "@type": "SubsetDefinition"
    },
    {
      "name": "fixp_finalizing",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpFinalizing",
      "description": "Messages that close a flow for good.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_core",
      "@type": "SubsetDefinition"
    }
  ],
  "types": [
    {
      "name": "string",
