{
  "name": "fixp",
  "annotations": [
    {
      "tag": "sources",
      "value": "FixRepositoryForFIXP.xml, SBEschemaForFIXP.xml, OrchestraForFIXP.xml"
    },
    {
      "tag": "fix_version",
      "value": "FIX.5.0SP2"
    },
    {
      "tag": "sbe_package",
      "value": "FIXP"
    },
    {
      "tag": "sbe_schema_id",
      "value": "2748"
    },
    {
      "tag": "sbe_byte_order",
      "value": "littleEndian"
    }
  ],
  "description": "LinkML schema for the FIX Performance (FIXP) Session Protocol, auto-generated from the upstream specification artifacts (FixRepositoryForFIXP.xml, SBEschemaForFIXP.xml, OrchestraForFIXP.xml).",
  "title": "FIXP (FIX Performance) Session Protocol",
  "notes": [
    "(c) Copyright FIX Protocol Limited. Creative Commons Attribution-NoDerivatives 4.0 International Public License (CC BY-ND 4.0) applies to the upstream FIXP specification.",
    "This LinkML schema is auto-generated by scripts/schema_to_linkml.py - edit the script (or the upstream XMLs) and re-run; do not edit this file by hand."
  ],
  "source": "https://github.com/FIXTradingCommunity/fixp-specification",
  "see_also": [
    "https://www.fixtrading.org/standards/fixp/",
    "https://github.com/FIXTradingCommunity/fixp-specification",
    "https://lmodel.github.io/fixp"
  ],
  "id": "https://w3id.org/lmodel/fixp",
  "version": "FIX.5.0SP2",
  "imports": [
    "linkml:types"
  ],
  "license": "Apache-2.0",
  "prefixes": [
