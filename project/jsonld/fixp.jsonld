          "tag": "fixp_sent_by",
          "value": "any",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_types",
          "value": "Recoverable Idempotent Unsequenced None",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_multicast",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_of",
          "value": "own",
          "@type": "Annotation"
        }
      ],
      "description": "Says that the sender's flow has carried its last application message, which begins finalization. It is repeated as the heartbeat until the answer comes.",
      "in_subset": [
        "fixp_finalizing"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_messages",
      "is_a": "FixpMessage",
      "slots": [
        "message_kind",
        "FixpFinishedSending_session_id",
        "FixpFinishedSending_last_seq_no"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/fixp/FixpFinishedSending",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpFinishedReceiving",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpFinishedReceiving",
      "annotations": [
        {
          "tag": "sbe_template_id",
          "value": "16",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_name",
          "value": "FinishedReceiving",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_sent_by",
          "value": "any",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_types",
          "value": "Recoverable Idempotent Unsequenced None",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_multicast",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_of",
          "value": "peer",
          "@type": "Annotation"
        }
      ],
      "description": "Answers FinishedSending once the last message of the peer's flow has been processed. After it the session is finalized and its identifier is spent.",
      "in_subset": [
        "fixp_finalizing"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_messages",
      "is_a": "FixpMessage",
      "slots": [
        "message_kind",
        "FixpFinishedReceiving_session_id"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/fixp/FixpFinishedReceiving",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpApplied",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpApplied",
      "annotations": [
        {
          "tag": "sbe_template_id",
          "value": "17",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_name",
          "value": "Applied",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_sent_by",
          "value": "any",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_types",
          "value": "Idempotent",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_multicast",
          "value": "false",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_of",
          "value": "peer",
          "@type": "Annotation"
        }
      ],
      "description": "An optional application message telling the party that sends an idempotent flow which of its operations took effect, where no business message already says so.",
      "comments": [
        "Like any application message, it uses up one number in the sequence of the flow it travels on."
      ],
      "in_subset": [
        "fixp_transferring"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_messages",
      "is_a": "FixpMessage",
      "slots": [
        "message_kind",
        "FixpApplied_from_seq_no",
        "FixpApplied_message_count"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/fixp/FixpApplied",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpNotApplied",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpNotApplied",
      "annotations": [
        {
          "tag": "sbe_template_id",
          "value": "18",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_name",
          "value": "NotApplied",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_sent_by",
          "value": "any",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_types",
          "value": "Idempotent",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_multicast",
          "value": "false",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_of",
          "value": "peer",
          "@type": "Annotation"
        }
      ],
      "description": "An application message telling the party that sends an idempotent flow about a gap: a run of operations that did not take effect. That party's application decides what to do.",
      "comments": [
        "Like any application message, it uses up one number in the sequence of the flow it travels on."
      ],
      "in_subset": [
        "fixp_transferring"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_messages",
      "is_a": "FixpMessage",
      "slots": [
        "message_kind",
        "FixpNotApplied_from_seq_no",
        "FixpNotApplied_message_count"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/fixp/FixpNotApplied",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpMessageTemplate",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpMessageTemplate",
      "annotations": [
        {
          "tag": "sbe_template_id",
          "value": "19",
          "@type": "Annotation"
        },
        {
          "tag": "sbe_name",
          "value": "MessageTemplate",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_sent_by",
          "value": "any",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_flow_types",
          "value": "Recoverable Idempotent Unsequenced None",
          "@type": "Annotation"
        },
        {
          "tag": "fixp_multicast",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "Hands the peer a template or schema it needs to read messages in an encoding that templates drive. There is no fixed moment for sending it.",
      "comments": [
        "A publisher does well to repeat it for late listeners. On a shared transport it applies to every session there."
      ],
      "in_subset": [
        "fixp_initialization"
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_messages",
      "is_a": "FixpMessage",
      "slots": [
        "message_kind",
        "FixpMessageTemplate_sofh_encoding_type",
        "effective_time",
        "template_version",
        "FixpMessageTemplate_template"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/fixp/FixpMessageTemplate",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpExchange",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpExchange",
      "description": "The messages of one session in the order they were sent, as a test case, a worked example or a captured log.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_exchange",
      "slots": [
        "id",
        "description",
        "fixpExchange__session_kind",
        "fixpExchange__multiplexed",
        "fixpExchange__exchange_steps"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "session_kind",
          "description": "Which of the two forms the session takes.",
          "range": "FixpSessionKind",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "multiplexed",
          "description": "Whether the transport carries other sessions too, so that Context takes the place of Sequence.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "exchange_steps",
          "description": "Each step of the exchange, in order.",
          "range": "FixpExchangeStep",
          "required": true,
          "multivalued": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/fixp/FixpExchange",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpExchangeStep",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpExchangeStep",
      "description": "One step: a FIXP message, or a run of application messages whose content FIXP does not define, and the side that sent it.",
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_exchange",
      "slots": [
        "fixpExchangeStep__sent_by",
        "fixpExchangeStep__fixp_message",
        "fixpExchangeStep__application_message_count"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sent_by",
          "description": "The side that sent this step.",
          "range": "FixpParty",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixp_message",
          "description": "The FIXP message sent.",
          "range": "FixpMessage",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "application_message_count",
          "description": "How many application messages went out one after another. On a sequenced flow each takes the next sequence number.",
          "range": "fixp_u32",
          "minimum_value": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/fixp/FixpExchangeStep",
      "exactly_one_of": [
        {
          "slot_conditions": [
            {
              "name": "fixp_message",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "slot_conditions": [
            {
              "name": "application_message_count",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpRulesOfEngagement",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpRulesOfEngagement",
      "description": "What two counterparties agree on for one FIXP service, layer by layer, for the client and for the server.",
      "comments": [
        "Appendix B calls its checklist an aid, and FIXP leaves each of these choices to the counterparties."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_engagement",
      "slots": [
        "id",
        "description",
        "fixpRulesOfEngagement__client_stack",
        "fixpRulesOfEngagement__server_stack"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "client_stack",
          "description": "What the client side uses.",
          "range": "FixpStackProfile",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "server_stack",
          "description": "What the server side uses.",
          "range": "FixpStackProfile",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/fixp/FixpRulesOfEngagement",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixpStackProfile",
      "definition_uri": "https://w3id.org/lmodel/fixp/FixpStackProfile",
      "description": "One side's choices at each layer of the stack: application, presentation, session, security and transport.",
      "comments": [
        "Beyond appendix B's rows, it holds what sections 3 and 4 leave to the two parties: the form of the credentials, the keep-alive intervals each side accepts, and the most messages one resend may cover."
      ],
      "from_schema": "https://w3id.org/lmodel/fixp/schema/fixp_engagement",
      "slots": [
        "fixpStackProfile__application_recovery",
        "fixpStackProfile__application_fix_version",
        "fixpStackProfile__service_pack",
        "fixpStackProfile__extension_packs",
        "fixpStackProfile__message_encoding",
        "fixpStackProfile__encoding_version",
        "fixpStackProfile__message_schemas",
        "fixpStackProfile__framing",
        "fixpStackProfile__supported_flow_types",
        "fixpStackProfile__shortest_keepalive_interval",
        "fixpStackProfile__longest_keepalive_interval",
        "fixpStackProfile__retransmission_limit",
        "fixpStackProfile__tls_version",
        "fixpStackProfile__authentication_methods",
        "fixpStackProfile__credentials_format",
        "fixpStackProfile__cipher_suites",
        "fixpStackProfile__transports",
        "fixpStackProfile__network_protocols"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "application_recovery",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "application",
              "@type": "Annotation"
            }
          ],
          "description": "Whether this side's applications recover lost messages themselves.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "application_fix_version",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "application",
              "@type": "Annotation"
            }
          ],
          "description": "The FIX version of the application messages, such as FIX.Latest.",
          "@type": "SlotDefinition"
        },
        {
          "name": "service_pack",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "application",
              "@type": "Annotation"
            }
          ],
          "description": "The FIX service pack, where the version has them.",
          "@type": "SlotDefinition"
        },
        {
          "name": "extension_packs",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "application",
              "@type": "Annotation"
            }
          ],
          "description": "The FIX extension packs in use.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "message_encoding",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "presentation",
              "@type": "Annotation"
            }
          ],
          "description": "How messages are encoded, such as Simple Binary Encoding.",
          "@type": "SlotDefinition"
        },
        {
          "name": "encoding_version",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "presentation",
              "@type": "Annotation"
            }
          ],
          "description": "The version of that encoding.",
          "@type": "SlotDefinition"
        },
        {
          "name": "message_schemas",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "presentation",
              "@type": "Annotation"
            }
          ],
          "description": "The message schemas or templates the encoding uses.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "framing",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "presentation",
              "@type": "Annotation"
            }
          ],
          "description": "What marks where one message ends and the next begins, such as the Simple Open Framing Header.",
          "@type": "SlotDefinition"
        },
        {
          "name": "supported_flow_types",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "session",
              "@type": "Annotation"
            }
          ],
          "description": "The flow types this side accepts or offers.",
          "range": "FixpFlowType",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "shortest_keepalive_interval",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "session",
              "@type": "Annotation"
            },
            {
              "tag": "fixp_section",
              "value": "4",
              "@type": "Annotation"
            }
          ],
          "description": "The shortest keep-alive interval, in milliseconds, that this side accepts from its peer.",
          "comments": [
            "An Establish that asks for a shorter one is refused with the KeepaliveInterval code."
          ],
          "range": "fixp_delta_millisecs",
          "@type": "SlotDefinition"
        },
        {
          "name": "longest_keepalive_interval",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "session",
              "@type": "Annotation"
            },
            {
              "tag": "fixp_section",
              "value": "4",
              "@type": "Annotation"
            }
          ],
          "description": "The longest keep-alive interval, in milliseconds, that this side accepts from its peer.",
          "comments": [
            "An Establish that asks for a longer one is refused with the KeepaliveInterval code."
          ],
          "range": "fixp_delta_millisecs",
          "@type": "SlotDefinition"
        },
        {
          "name": "retransmission_limit",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "session",
              "@type": "Annotation"
            },
            {
              "tag": "fixp_section",
              "value": "4",
              "@type": "Annotation"
            }
          ],
          "description": "The most messages this side resends in answer to one RetransmitRequest.",
          "comments": [
            "A request for more may be refused with the RequestLimitExceeded code."
          ],
          "range": "fixp_u32",
          "minimum_value": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "tls_version",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "security",
              "@type": "Annotation"
            }
          ],
          "description": "The TLS version that protects the transport.",
          "@type": "SlotDefinition"
        },
        {
          "name": "authentication_methods",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "security",
              "@type": "Annotation"
            }
          ],
          "description": "How the parties prove who they are.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "credentials_format",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "security",
              "@type": "Annotation"
            },
            {
              "tag": "fixp_section",
              "value": "3",
              "@type": "Annotation"
            }
          ],
          "description": "The form of the credentials this side sends, and how its peer checks them.",
          "comments": [
            "FIXP carries credentials as opaque octets and leaves their form to the two parties."
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "cipher_suites",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "security",
              "@type": "Annotation"
            }
          ],
          "description": "The cipher suites allowed.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "transports",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "transport",
              "@type": "Annotation"
            }
          ],
          "description": "The transports this side can use, for example TCP, or UDP with multicast.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "network_protocols",
          "annotations": [
            {
              "tag": "stack_layer",
              "value": "transport",
              "@type": "Annotation"
            }
          ],
          "description": "Any other network protocols in use.",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/fixp/FixpStackProfile",
      "@type": "ClassDefinition"
    }
  ],
